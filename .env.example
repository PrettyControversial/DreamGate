# Optional overrides for native/staging builds. Production iOS builds default
# to the deployed DreamGate API and derive its public Clerk publishable key.
VITE_API_BASE_URL=https://dream-gate.replit.app
VITE_CLERK_PROXY_URL=https://dream-gate.replit.app/api/__clerk

# Only a public pk_test_ or pk_live_ value belongs here. Never expose a Clerk
# secret key (sk_test_ or sk_live_) through a VITE_ variable.
VITE_CLERK_PUBLISHABLE_KEY=
